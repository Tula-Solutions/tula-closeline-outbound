# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576

# The Region this deployment serves (required outside local; local defaults to us).
# REGION=us
# Sentry DSN of this Region's project (required outside local).
# SENTRY_DSN=
# Postgres login of closeline_outbound. Local default is the compose Postgres on 5432.
# DATABASE_URL=postgres://closeline_outbound:closeline_outbound_local@127.0.0.1:5432/closeline
# Where the auth service publishes its signing keys, the issuer and the audience of its tokens.
# AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
# AUTH_ISSUER=http://127.0.0.1:3001
# AUTH_AUDIENCE=closeline
# AWS Region of the queue, its URL, and (local only) ElasticMQ's endpoint. No QUEUE_URL locally
# means an in-memory queue that loses its messages on a restart.
# AWS_REGION=us-east-1
# QUEUE_URL=
# QUEUE_ENDPOINT=
# Messages handled at once, and the longest the consumer waits for them on shutdown, in ms.
CONSUMER_CONCURRENCY=4
CONSUMER_STOP_DEADLINE_MS=5000
# Most one Organization may spend on enrichment providers in a UTC month, in micro-dollars
# (1_000_000 = 1 USD). Checked before every provider call. Default 50 USD.
ENRICHMENT_MONTHLY_BUDGET_MICROS=50000000
# Most one enrichment run may spend, in micro-dollars (the run ceiling). Default 1 USD.
ENRICHMENT_RUN_CEILING_MICROS=1000000
# Longest one provider call may take, in ms; most tries of one call; first retry delay (doubles, jittered), in ms.
ENRICHMENT_PROVIDER_TIMEOUT_MS=10000
ENRICHMENT_PROVIDER_MAX_TRIES=2
ENRICHMENT_RETRY_BASE_MS=200
# How long a run stays claimed by one worker before another may take it over, in seconds.
ENRICHMENT_RUN_LEASE_SECONDS=120
