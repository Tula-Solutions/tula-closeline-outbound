# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576

# The Region this deployment serves (required outside local; local defaults to us).
# REGION=us
# Sentry DSN of this Region's project (required outside local).
# SENTRY_DSN=
# Postgres login of closeline_outbound. Local default is the compose Postgres on 5432.
# DATABASE_URL=postgres://closeline_outbound:closeline_outbound_local@127.0.0.1:5432/closeline
# Where the auth service publishes its signing keys, the issuer and the audience of its tokens.
# AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
# AUTH_ISSUER=http://127.0.0.1:3001
# AUTH_AUDIENCE=closeline
# AWS Region of the queue, its URL, and (local only) ElasticMQ's endpoint. No QUEUE_URL locally
# means an in-memory queue that loses its messages on a restart.
# AWS_REGION=us-east-1
# QUEUE_URL=
# QUEUE_ENDPOINT=
# Messages handled at once, and the longest the consumer waits for them on shutdown, in ms.
CONSUMER_CONCURRENCY=4
# Sequence engine: ENGINE_ENABLED=true turns the sweep on (off by default: drafts, approvals and contacts are still in-memory stand-ins). Sweep interval in ms (0 turns it off), Organizations per page, Enrollments per Organization, lease in seconds.
ENGINE_ENABLED=false
ENGINE_SWEEP_INTERVAL_MS=30000
ENGINE_ORG_BATCH=50
ENGINE_STEP_PAGE=100
ENGINE_LEASE_SECONDS=600
CONSUMER_STOP_DEADLINE_MS=5000
# Most one Organization may spend on enrichment providers in a UTC month, in micro-dollars
# (1_000_000 = 1 USD). Checked before every provider call. Default 50 USD.
ENRICHMENT_MONTHLY_BUDGET_MICROS=50000000
# Most one enrichment run may spend, in micro-dollars (the run ceiling). Default 1 USD.
ENRICHMENT_RUN_CEILING_MICROS=1000000
# Longest one provider call may take, in ms; most tries of one call; first retry delay (doubles, jittered), in ms.
ENRICHMENT_PROVIDER_TIMEOUT_MS=10000
ENRICHMENT_PROVIDER_MAX_TRIES=2
ENRICHMENT_RETRY_BASE_MS=200
# How long a run stays claimed by one worker before another may take it over, in seconds.
ENRICHMENT_RUN_LEASE_SECONDS=120
# Apollo and ZeroBounce origins; consecutive failures that open a provider's circuit; ms it stays open.
# An Organization's own keys are stored through PUT /v1/enrichment/providers/{provider}, never here.
# APOLLO_BASE_URL=https://api.apollo.io
# ZEROBOUNCE_BASE_URL=https://api.zerobounce.net
PROVIDER_CIRCUIT_FAILURES=5
PROVIDER_CIRCUIT_OPEN_MS=30000
# Anthropic (model) and Exa (web search) keys, platform-wide; unset means the in-memory stand-ins
# locally and no model or web search elsewhere. ANTHROPIC_NO_TRAINING_CONFIRMED=true is required to
# use the key. Budget and prices are micro-dollars (1_000_000 = 1 USD).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_NO_TRAINING_CONFIRMED=false
# EXA_API_KEY=
# EXA_BASE_URL=https://api.exa.ai
MODEL_MONTHLY_BUDGET_MICROS=50000000
MODEL_INPUT_MICROS_PER_MILLION=3000000
MODEL_OUTPUT_MICROS_PER_MILLION=15000000
AI_CALL_TIMEOUT_MS=20000
AI_CALL_MAX_TRIES=2
AI_RETRY_BASE_MS=200
# Core's origin and the shared secret core accepts from this service (its INTERNAL_API_TOKENS, ADR
# 0013). Setting CORE_URL, here or in any environment, uses core over HTTP for the enrichment read
# and write-back and for the Contact Check (consent and suppression, which fails closed); unset in
# local means an in-memory core and a Contact Check that denies everyone. Required outside local.
# CORE_URL=http://127.0.0.1:3002
# CORE_INTERNAL_SECRET=
# Longest one call to core may take, in ms; most tries of one call (network error or 503), jittered.
CORE_CALL_TIMEOUT_MS=5000
CORE_CALL_MAX_TRIES=3

# Gmail Mailboxes. Without GOOGLE_CLIENT_ID a local run uses an in-memory provider that consents at
# once. The four endpoint URLs default to Google's; a local run points them at the fake provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GMAIL_API_BASE_URL=https://gmail.googleapis.com
# Outlook Mailboxes (Microsoft Graph, tenant common). Without MICROSOFT_CLIENT_ID a local run uses an
# in-memory provider that consents at once. The three URLs default to Microsoft's.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
# MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
# GRAPH_API_BASE_URL=https://graph.microsoft.com
# Where the provider sends the person back to (the portal completes the connection). Required with GOOGLE_CLIENT_ID or MICROSOFT_CLIENT_ID outside local.
# MAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/mailboxes/connect/callback
# Signs connect attempts, at least 32 characters; required outside local.
# MAIL_STATE_SECRET=
# Local AES key for sealing tokens, base64 of 32 bytes (openssl rand -base64 32). local and dev only; KMS replaces it.
# MAIL_SECRET_BOX_KEY=
# Longest one provider call may take, in ms; most tries of one repeatable call; first retry delay (doubles, jittered), in ms.
MAIL_CALL_TIMEOUT_MS=10000
MAIL_CALL_MAX_TRIES=3
MAIL_RETRY_BASE_MS=200
# Where the unsubscribe link in every email points; the signed token is appended. Required outside local.
# MAIL_UNSUBSCRIBE_URL=http://127.0.0.1:3000/unsubscribe
# Gmail push (Pub/Sub): the URL it pushes to and the service account it signs as. Without both, the Gmail webhook refuses every call outside local.
# GMAIL_PUSH_AUDIENCE=https://outbound.example.com/v1/public/mail/webhooks/gmail
# GMAIL_PUSH_SERVICE_ACCOUNT=push@project.iam.gserviceaccount.com
# The most emails the Organization sends in one UTC day across all its Mailboxes.
MAIL_ORG_DAILY_CAP=500
